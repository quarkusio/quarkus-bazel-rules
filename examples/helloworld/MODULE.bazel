module(name = "helloworld")

bazel_dep(name = "rules_quarkus", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "rules_quarkus",
    path = "../..",
)

# Fix bazel 9.x issues
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_android", version = "0.7.1", repo_name = "rules_android")
bazel_dep(name = "rules_go", version = "0.61.0", repo_name = "rules_go")

# JVM rules
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm_external", version = "6.10")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "io.quarkus:quarkus-rest",
        "io.quarkus:quarkus-arc",
        # Test dependencies
        "io.quarkus:quarkus-junit",
        "io.quarkus:quarkus-jacoco",
        "io.rest-assured:rest-assured:6.0.1",
        "org.junit.jupiter:junit-jupiter:6.1.3",
        "org.junit.platform:junit-platform-console-standalone:6.1.3",
        "org.junit.platform:junit-platform-launcher:6.1.3",
    ],
    # Mirror pom.xml so Maven and Bazel select the same platform versions.
    boms = ["io.quarkus.platform:quarkus-bom:4.0.1"],
    # Quarkus 4: the CDI 4 coordinates relocate to jakarta.cdi through a broken
    # parent POM that Coursier cannot resolve. Quarkus already depends on the
    # jakarta.cdi artifacts directly, so excluding the old names is lossless.
    excluded_artifacts = [
        "jakarta.enterprise:jakarta.enterprise.cdi-api",
        "jakarta.enterprise:jakarta.enterprise.lang-model",
    ],
    known_contributing_modules = [
        "bazel_worker_java",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")

quarkus = use_extension("@rules_quarkus//quarkus:extensions.bzl", "quarkus")
quarkus.toolchain(
    lock_file = "//:maven_install.json",
    quarkifier_source_dir = "@rules_quarkus//:MODULE.bazel",
    quarkus_version = "4.0.1",
)
use_repo(quarkus, "quarkus")
